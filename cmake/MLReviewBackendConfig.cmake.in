# Time cmake module
#
# The following import targets are created
#
# ::
#   mlReviewBackend_FOUND - true if mlReviewBackend library was found on the system
#   mlReviewBackend_INCLUDE_DIR - the directory containing mlReviewBackend headers
#   mlReviewBackend_LIBRARY - the mlReviewBackend library

include(CMakeFindDependencyMacro)

if (NOT TARGET MLReviewBackend::@PROJECT_NAME@)
   include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
endif()
